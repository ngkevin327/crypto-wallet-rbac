# Server
NODE_ENV=development
PORT=3001
API_PREFIX=v1

# Database
DATABASE_URL=postgresql://wtp:wtp_local@localhost:5432/wtp?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-use-long-random-string-in-production
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=30d
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3

# Ethereum / Safe
ETH_RPC_URL_SEPOLIA=https://eth-sepolia.g.alchemy.com/v2/your-key
ETH_RPC_URL_MAINNET=https://eth-mainnet.g.alchemy.com/v2/your-key
SAFE_TX_SERVICE_URL_SEPOLIA=https://safe-transaction-sepolia.safe.global
SAFE_TX_SERVICE_URL_MAINNET=https://safe-transaction-mainnet.safe.global

# Price oracle
COINGECKO_API_KEY=

# Email (optional in dev — console adapter)
SES_REGION=us-east-1
SES_FROM_EMAIL=noreply@yourdomain.com
WEB_APP_URL=http://localhost:3000

# AWS (audit export, production)
AWS_REGION=us-east-1
S3_AUDIT_EXPORT_BUCKET=
