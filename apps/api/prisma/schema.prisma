generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  mfaEnabled   Boolean   @default(false) @map("mfa_enabled")
  mfaSecret    String?   @map("mfa_secret")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  sessions     Session[]
  members      Member[]

  @@map("users")
}

enum PlatformRole {
  org_admin
  org_member
  org_viewer
}

enum MemberStatus {
  invited
  active
  deactivated
}

enum RoleTemplateType {
  founder
  finance
  marketing
  engineering
  operations
  viewer
}

enum IntentStatus {
  draft
  policy_evaluated
  denied
  pending_approval
  ready_to_sign
  submitted
  executed
  failed
  cancelled
}

enum IntentSource {
  web
  api
}

enum IntentType {
  transfer
  deploy
}

enum RoleAssignmentStatus {
  scheduled
  active
  expired
  revoked
}

enum AuditExportJobStatus {
  pending
  processing
  completed
  failed
}

enum ApprovalRequestStatus {
  pending
  fulfilled
  rejected
  expired
}

enum ApprovalDecisionType {
  approved
  rejected
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  members   Member[]
  invites   Invite[]
  wallets   Wallet[]
  roles     Role[]
  policies        Policy[]
  intents         TransactionIntent[]
  apiKeys         ApiKey[]
  auditExportJobs AuditExportJob[]

  @@map("organizations")
}

model Role {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String
  templateType   RoleTemplateType @map("template_type")
  createdAt      DateTime         @default(now()) @map("created_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments    RoleAssignment[]
  policies       Policy[]
  apiKeys        ApiKey[]

  @@unique([organizationId, templateType])
  @@index([organizationId])
  @@map("roles")
}

model RoleAssignment {
  id        String               @id @default(uuid()) @db.Uuid
  memberId  String               @map("member_id") @db.Uuid
  roleId    String               @map("role_id") @db.Uuid
  walletId  String?              @map("wallet_id") @db.Uuid
  status    RoleAssignmentStatus @default(active)
  startsAt  DateTime             @default(now()) @map("starts_at")
  endsAt    DateTime?            @map("ends_at")
  createdAt DateTime             @default(now()) @map("created_at")
  member    Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role      Role                 @relation(fields: [roleId], references: [id], onDelete: Cascade)
  wallet    Wallet?              @relation(fields: [walletId], references: [id], onDelete: SetNull)

  @@index([memberId, status])
  @@index([roleId])
  @@index([status, endsAt])
  @@map("role_assignments")
}

model TransactionIntent {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  walletId           String       @map("wallet_id") @db.Uuid
  memberId           String       @map("member_id") @db.Uuid
  intentType         IntentType   @default(transfer) @map("intent_type")
  source             IntentSource @default(web)
  apiKeyId           String?      @map("api_key_id") @db.Uuid
  tokenAddress       String       @map("token_address")
  chainId            Int          @map("chain_id")
  amountNative       String       @map("amount_native")
  amountUsd          Decimal?     @map("amount_usd") @db.Decimal(20, 6)
  toAddress          String       @map("to_address")
  calldata           String?
  status             IntentStatus @default(draft)
  policyVersionId    String?      @map("policy_version_id") @db.Uuid
  policyDecisionJson Json         @default("{}") @map("policy_decision_json")
  safeTxHash         String?      @map("safe_tx_hash")
  txHash             String?      @map("tx_hash")
  failureReason      String?      @map("failure_reason")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  wallet             Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  member             Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  policyVersion      Policy?         @relation(fields: [policyVersionId], references: [id], onDelete: SetNull)
  approvalRequests   ApprovalRequest[]

  @@index([organizationId, status])
  @@index([memberId, createdAt(sort: Desc)])
  @@map("transaction_intents")
}

enum PolicyStatus {
  active
  archived
}

model Policy {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  walletId       String?      @map("wallet_id") @db.Uuid
  version        Int          @default(1)
  status         PolicyStatus @default(active)
  rules          Json         @default("[]")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  wallet         Wallet?             @relation(fields: [walletId], references: [id], onDelete: SetNull)
  intents        TransactionIntent[]

  @@index([organizationId])
  @@index([roleId, walletId])
  @@map("policies")
}

model Wallet {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  address        String
  chainId        Int          @map("chain_id")
  nickname       String?
  safeThreshold  Int?         @map("safe_threshold")
  safeOwners     String[]     @default([]) @map("safe_owners")
  lastSyncedAt   DateTime?    @map("last_synced_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleAssignments RoleAssignment[]
  policies        Policy[]
  intents         TransactionIntent[]

  @@unique([organizationId, address, chainId])
  @@index([organizationId])
  @@map("wallets")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  partitionKey   String   @map("partition_key") @db.VarChar(7)
  eventType      String   @map("event_type")
  actorId        String?  @map("actor_id") @db.Uuid
  payload        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, eventType, createdAt(sort: Desc)])
  @@index([partitionKey, createdAt(sort: Desc)])
  @@map("audit_events")
}

model AuditExportJob {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  status         AuditExportJobStatus @default(pending)
  fromDate       DateTime             @map("from_date")
  toDate         DateTime             @map("to_date")
  s3Key          String?              @map("s3_key")
  rowCount       Int?                 @map("row_count")
  errorMessage   String?              @map("error_message")
  createdAt      DateTime             @default(now()) @map("created_at")
  completedAt    DateTime?            @map("completed_at")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("audit_export_jobs")
}

model ApiKey {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  keyPrefix      String    @map("key_prefix")
  keyHash        String    @map("key_hash")
  roleId         String    @map("role_id") @db.Uuid
  ipAllowlist    String[]  @default([]) @map("ip_allowlist")
  lastUsedAt     DateTime? @map("last_used_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([organizationId, revokedAt])
  @@index([keyPrefix])
  @@map("api_keys")
}

model Member {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  platformRole   PlatformRole @default(org_member) @map("platform_role")
  status         MemberStatus @default(active)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleAssignments RoleAssignment[]
  intents         TransactionIntent[]
  approvalDecisions ApprovalDecision[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@map("members")
}

enum InviteStatus {
  pending
  accepted
  revoked
  expired
}

model Invite {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  email          String
  tokenHash      String       @map("token_hash")
  platformRole   PlatformRole @default(org_member) @map("platform_role")
  status         InviteStatus @default(pending)
  invitedById    String       @map("invited_by_id") @db.Uuid
  expiresAt      DateTime     @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([tokenHash])
  @@map("invites")
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash")
  expiresAt        DateTime @map("expires_at")
  userAgent        String?  @map("user_agent")
  ipAddress        String?  @map("ip_address")
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model ApprovalRequest {
  id                 String                @id @default(uuid()) @db.Uuid
  intentId           String                @map("intent_id") @db.Uuid
  requiredCount      Int                   @map("required_count")
  approverRoleIds    String[]              @default([]) @map("approver_role_ids")
  status             ApprovalRequestStatus @default(pending)
  expiresAt          DateTime              @map("expires_at")
  reminder24hSentAt  DateTime?             @map("reminder_24h_sent_at")
  reminder72hSentAt  DateTime?             @map("reminder_72h_sent_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  intent          TransactionIntent     @relation(fields: [intentId], references: [id], onDelete: Cascade)
  decisions       ApprovalDecision[]

  @@index([intentId])
  @@index([status, expiresAt])
  @@map("approval_requests")
}

model ApprovalDecision {
  id        String               @id @default(uuid()) @db.Uuid
  requestId String               @map("request_id") @db.Uuid
  memberId  String               @map("member_id") @db.Uuid
  decision  ApprovalDecisionType
  note      String?
  decidedAt DateTime             @default(now()) @map("decided_at")
  request   ApprovalRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  member    Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([requestId, memberId])
  @@index([memberId])
  @@map("approval_decisions")
}
