generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  mfaEnabled   Boolean   @default(false) @map("mfa_enabled")
  mfaSecret    String?   @map("mfa_secret")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  sessions     Session[]
  members      Member[]

  @@map("users")
}

enum PlatformRole {
  org_admin
  org_member
  org_viewer
}

enum MemberStatus {
  invited
  active
  deactivated
}

enum RoleTemplateType {
  founder
  finance
  marketing
  engineering
  operations
  viewer
}

enum IntentStatus {
  draft
  policy_evaluated
  denied
  pending_approval
  ready_to_sign
  submitted
  executed
  failed
  cancelled
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  members   Member[]
  invites   Invite[]
  wallets   Wallet[]
  roles     Role[]
  policies  Policy[]
  intents   TransactionIntent[]

  @@map("organizations")
}

model Role {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String
  templateType   RoleTemplateType @map("template_type")
  createdAt      DateTime         @default(now()) @map("created_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments    RoleAssignment[]
  policies       Policy[]

  @@unique([organizationId, templateType])
  @@index([organizationId])
  @@map("roles")
}

model RoleAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  memberId  String    @map("member_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  walletId  String?   @map("wallet_id") @db.Uuid
  startsAt  DateTime  @default(now()) @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  createdAt DateTime  @default(now()) @map("created_at")
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  wallet    Wallet?   @relation(fields: [walletId], references: [id], onDelete: SetNull)

  @@index([memberId])
  @@index([roleId])
  @@map("role_assignments")
}

model TransactionIntent {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  walletId           String       @map("wallet_id") @db.Uuid
  memberId           String       @map("member_id") @db.Uuid
  tokenAddress       String       @map("token_address")
  chainId            Int          @map("chain_id")
  amountNative       String       @map("amount_native")
  amountUsd          Decimal?     @map("amount_usd") @db.Decimal(20, 6)
  toAddress          String       @map("to_address")
  calldata           String?
  status             IntentStatus @default(draft)
  policyVersionId    String?      @map("policy_version_id") @db.Uuid
  policyDecisionJson Json         @default("{}") @map("policy_decision_json")
  safeTxHash         String?      @map("safe_tx_hash")
  txHash             String?      @map("tx_hash")
  failureReason      String?      @map("failure_reason")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  wallet             Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  member             Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  policyVersion      Policy?         @relation(fields: [policyVersionId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([memberId, createdAt(sort: Desc)])
  @@map("transaction_intents")
}

enum PolicyStatus {
  active
  archived
}

model Policy {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  walletId       String?      @map("wallet_id") @db.Uuid
  version        Int          @default(1)
  status         PolicyStatus @default(active)
  rules          Json         @default("[]")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  wallet         Wallet?             @relation(fields: [walletId], references: [id], onDelete: SetNull)
  intents        TransactionIntent[]

  @@index([organizationId])
  @@index([roleId, walletId])
  @@map("policies")
}

model Wallet {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  address        String
  chainId        Int          @map("chain_id")
  nickname       String?
  safeThreshold  Int?         @map("safe_threshold")
  safeOwners     String[]     @default([]) @map("safe_owners")
  lastSyncedAt   DateTime?    @map("last_synced_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleAssignments RoleAssignment[]
  policies        Policy[]
  intents         TransactionIntent[]

  @@unique([organizationId, address, chainId])
  @@index([organizationId])
  @@map("wallets")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  eventType      String   @map("event_type")
  actorId        String?  @map("actor_id") @db.Uuid
  payload        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([eventType, createdAt])
  @@map("audit_events")
}

model Member {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  platformRole   PlatformRole @default(org_member) @map("platform_role")
  status         MemberStatus @default(active)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleAssignments RoleAssignment[]
  intents         TransactionIntent[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@map("members")
}

enum InviteStatus {
  pending
  accepted
  revoked
  expired
}

model Invite {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  email          String
  tokenHash      String       @map("token_hash")
  platformRole   PlatformRole @default(org_member) @map("platform_role")
  status         InviteStatus @default(pending)
  invitedById    String       @map("invited_by_id") @db.Uuid
  expiresAt      DateTime     @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([tokenHash])
  @@map("invites")
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash")
  expiresAt        DateTime @map("expires_at")
  userAgent        String?  @map("user_agent")
  ipAddress        String?  @map("ip_address")
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
