{
  "name": "wallet-team-permissions",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:worker": "pnpm --filter @wtp/api worker:dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:wait": "tsx scripts/wait-for-db.ts",
    "setup:local": "pnpm db:up && pnpm db:wait && pnpm --filter @wtp/api db:generate && pnpm --filter @wtp/api db:push",
    "verify:local": "tsx scripts/verify-local.ts",
    "perf:policy": "pnpm --filter @wtp/api exec tsx src/policy/policy-evaluation.bench.ts",
    "test:mvp-acceptance": "pnpm --filter @wtp/api test:e2e -- mvp-acceptance"
  },
  "devDependencies": {
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
