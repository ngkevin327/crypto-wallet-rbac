[
  {
    "name": "api",
    "image": "${image}",
    "essential": true,
    "portMappings": [
      {
        "containerPort": 3001,
        "protocol": "tcp"
      }
    ],
    "environment": [
      { "name": "NODE_ENV", "value": "production" },
      { "name": "PORT", "value": "3001" }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/wtp/api",
        "awslogs-region": "us-east-1",
        "awslogs-stream-prefix": "api"
      }
    },
    "healthCheck": {
      "command": ["CMD-SHELL", "wget -qO- http://localhost:3001/v1/health || exit 1"],
      "interval": 30,
      "timeout": 5,
      "retries": 3
    }
  }
]
